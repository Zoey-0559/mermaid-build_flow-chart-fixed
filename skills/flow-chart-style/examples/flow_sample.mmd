%% =============================================================
%%  範例：訂單處理流程 — 展示 5 種箭頭語意 + 2 個群組
%%  樣式對應 flow_chart_style.json v1.0.0
%%  匯出（建議用腳本，會自動去除 Kroki 誤加的節點陰影）：
%%    ./render.sh flow_sample        -> flow_sample.svg (+ .png)
%%  純 curl 版（SVG 會殘留 neo 陰影，需自行把 filter:drop-shadow(...) 改 none）：
%%    curl -X POST -H "Content-Type: text/plain" --data-binary @flow_sample.mmd \
%%         https://kroki.io/mermaid/svg -o flow_sample.svg
%% =============================================================

%%{init: {
  "theme": "base",
  "fontFamily": "roboto, Noto Sans, PingFang TC, Sans-Serif, Microsoft JhengHei",
  "themeVariables": {
    "fontFamily": "roboto, Noto Sans, PingFang TC, Sans-Serif, Microsoft JhengHei",
    "background": "#F7F7F7",
    "edgeLabelBackground": "#FFFFFF",
    "lineColor": "#000000",
    "primaryColor": "#FFFFFF",
    "primaryBorderColor": "#C0C6CB",
    "primaryTextColor": "#000000"
  },
  "themeCSS": ".node polygon,.node circle,.node rect,.node path,.node .outer-path{filter:none} .cluster rect{filter:none}",
  "flowchart": { "curve": "basis", "nodeSpacing": 40, "rankSpacing": 55 }
}}%%

flowchart TD

  start(["開始 · 接單"]):::pillGray

  subgraph gVerify["驗證階段"]
    direction TB
    recv("接收訂單請求"):::cardDefault
    stock{"庫存是否足夠？"}:::decision
  end

  ship("建立出貨單"):::cardDefault
  restock("通知補貨並排程<br/>(等待供應商回覆)"):::cardDefault
  audit("記錄稽核日誌<br/>(稽核追蹤用)"):::cardDefault

  subgraph gDone["完成階段"]
    direction TB
    notify("寄送出貨通知"):::cardDefault
    done(["訂單完成"]):::pillOrange
  end

  %% ---- 連線（linkStyle 依此順序編號，0 起算；Mermaid 不支援行內註解）----
  %%  0 start->recv     default 黑
  %%  1 recv->stock     default 黑
  %%  2 stock->ship     success 綠
  %%  3 stock->restock  danger 紅
  %%  4 ship->notify    default 黑
  %%  5 ship->audit     info 藍（資訊性支線）
  %%  6 notify->done    default 黑
  %%  7 restock->recv   muted 灰虛線（弱關聯回溯）
  start --> recv
  recv --> stock
  stock -->|"足夠"| ship
  stock -->|"不足"| restock
  ship --> notify
  ship --> audit
  notify --> done
  restock -->|"補貨完成後重試"| recv

  %% =============================================================
  %%  固定樣式區塊
  %% =============================================================

  classDef pillGray      fill:#D9DDE0,stroke:#000000,stroke-width:2px,color:#000000
  classDef pillOrange    fill:#FFEAC7,stroke:#F69800,stroke-width:2px,color:#A34900
  classDef cardDefault   fill:#FFFFFF,stroke:#C0C6CB,stroke-width:2px,color:#000000
  classDef cardSegmented fill:#FFFFFF,stroke:#C0C6CB,stroke-width:2px,color:#000000
  classDef decision      fill:#D4F3F6,stroke:#144F66,stroke-width:2px,color:#003D56

  %% 群組框：藍底用 #79CFDD、黃底用 #F69800；底色比成員更淺
  style gVerify fill:#EAF4F6,stroke:#79CFDD,stroke-width:2px,color:#003D56
  style gDone   fill:#FFF3E0,stroke:#F69800,stroke-width:2px,color:#A34900

  %% 逐條指定；不要用 linkStyle default（會讓所有箭頭 marker 變同一色）
  linkStyle 0,1,4,6 stroke:#000000,color:#000000,stroke-width:2px
  linkStyle 2 stroke:#00A513,color:#00A513,stroke-width:2px
  linkStyle 3 stroke:#FF0033,color:#FF0033,stroke-width:2px
  linkStyle 5 stroke:#009DDB,color:#009DDB,stroke-width:2px
  linkStyle 7 stroke:#9F9F9F,color:#9F9F9F,stroke-width:2px,stroke-dasharray:8 4
