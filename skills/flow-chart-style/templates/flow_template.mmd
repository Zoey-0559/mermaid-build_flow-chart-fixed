%% =============================================================
%%  Flow Chart Style — 起手式（給 build_flow.py 用的「純」flowchart）
%%
%%  1) 用腳本（最快）：
%%       python3 build_flow.py flow_template.mmd            -> .styled.mmd + .svg
%%       python3 build_flow.py flow_template.mmd --png      -> 另存 PNG 預覽
%%     腳本會自動：注入 init 標頭、為每個節點加 :::類名、
%%     依連線順序自動編號 linkStyle、產生群組框 style、驗證後出圖。
%%
%%  2) 提示（全部可省略，省略時由腳本推斷）：
%%       節點行  %% @pillGray | @pillOrange | @cardDefault | @cardSegmented | @decision
%%       連線行  %% @default | @success | @info | @danger | @muted
%%       subgraph 行  %% @group blue | @group yellow
%%
%%  推斷規則：{ } 菱形 -> decision；第一個節點 / 無入線 -> pillGray；
%%           無出線 -> pillOrange；其餘 -> cardDefault。
%% =============================================================

flowchart TB

  start(["開始"])
  step1["一般處理步驟"]
  choice{"判斷條件？"}
  done(["流程完成"])

  subgraph g1["群組標題"]        %% @group blue
    step1
    choice
  end

  start --> step1
  step1 --> choice
  choice -->|"成立"| done        %% @success
  choice -->|"不成立"| step1      %% @danger

